{
  "name": "gridiron-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node build-server.mjs",
    "test": "node --import tsx --test engine.test.ts validation.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gridiron 'node --import tsx --test rules.test.ts'",
    "test:integration": "firebase emulators:exec --only auth,firestore,functions --project demo-gridiron 'node --import tsx --test integration.test.ts'",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "@playwright/test": "^1.51.0"
  }
}
